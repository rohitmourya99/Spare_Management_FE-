# ==============================================
# Enterprise Spare IMS - Backend Environment
# ==============================================
# Copy this file to .env and update values

# -------------------
# Database
# -------------------
DATABASE_URL="postgresql://spare_admin:Spare@Admin123@localhost:5432/spare_inventory_db"

# -------------------
# JWT Secrets (CHANGE IN PRODUCTION - use 64+ chars)
# -------------------
JWT_SECRET="spare-ims-super-secret-jwt-key-proactive-data-systems-2026"
JWT_REFRESH_SECRET="spare-ims-super-secret-refresh-key-proactive-data-systems-2026"
JWT_EXPIRES_IN="100y"
JWT_REFRESH_EXPIRES_IN="100y"

# -------------------
# Server
# -------------------
PORT=5000
NODE_ENV=development

# -------------------
# CORS - Frontend URL
# -------------------
FRONTEND_URL="http://localhost:5173"

# -------------------
# File Upload
# -------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# -------------------
# Timezone
# -------------------
TZ="Asia/Kolkata"

# -------------------
# Rate Limiting
# -------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# -------------------
# SMTP Email (Optional - skip for now)
# -------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourmail@gmail.com
# SMTP_PASS=yourapppassword
# SMTP_FROM="Spare IMS <yourmail@gmail.com>"
